<!DOCTYPE html>
<html>

<head>
    <title>Our Store</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}"/>
    <style>
        body {
            margin: 0;
            padding: 20px;
            background-color: #f7f7f5;
            text-align: center;
        }

        h1 {
            color: #2c3e50;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            margin: 0 0 20px 0;
            padding: 20px;
            background-color: #ffffff;
            border: 1px solid #e5e5e5;
        }

        ul {
            padding: 0;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 24px;
        }

        li {
            background-color: #ffffff;
            padding: 18px;
            border: 1px solid #e5e5e5;
            height: 320px;
            width: 100%;
            text-align: center;
            position: relative;
        }

        li:hover {
            background-color: #fafafa;
            border: 1px solid #2c3e50;
        }

        a:hover {
            color: #ffffff;
            background-color: #2c3e50;
        }

        img {
            height: 220px;
            width: 100%;
            display: block;
            margin: 0 auto 16px auto;
        }

        span {
            color: #2c3e50;
            font-size: 18px;
            font-weight: bold;
            display: block;
            margin: 8px 0;
        }

        .price {
            color: #2c3e50;
            font-size: 20px;
            font-weight: bold;
            margin: 12px auto;
            padding: 8px;
            background-color: #f7f7f5;
            border: 1px solid #e5e5e5;
            text-align: center;
        }

        .btn-delete {
            background-color: #ffffff;
            color: #b91c1c;
            font-size: 13px;
            border: 1px solid #b91c1c;
            padding: 8px 16px;
            margin: 8px 0;
            display: inline-block;
            text-align: center;
        }

        .btn-delete:hover {
            background-color: #b91c1c;
            color: #ffffff;
        }

        .btn-add {
            background-color: #2c3e50;
            color: #ffffff;
            padding: 14px 28px;
            font-size: 16px;
            font-weight: bold;
            border: 1px solid #2c3e50;
            margin: 40px auto;
            width: 220px;
            display: block;
            text-align: center;
        }

        .btn-add:hover {
            background-color: #1c2833;
            border: 1px solid #1c2833;
        }
    </style>
</head>

<body>

    <div>
        <h1>Our Products</h1>
    </div>

    <div>
        <ul>
            {% for product in products %}
            <li>
                <div>
                    <a href="{{ url_for('details', product_id=product.id) }}">
                        <img src="{{ product.image }}"/>
                        <span>{{ product.name }}</span>
                    </a>

                    <span class="price">${{ product.price }}</span>

                    <form
                          action="{{ url_for('delete_product_route', product_id=product.id) }}"
                          method="post">
                        <button class="btn-delete" type="submit">
                            Remove
                        </button>
                    </form>
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>

    <div>
        <button class="btn-add">
            <a href="{{ url_for('add_product') }}">
                Add New Product
            </a>
        </button>
    </div>

</body>

</html>
