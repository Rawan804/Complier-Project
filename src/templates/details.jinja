<!DOCTYPE html>
<html>
<head>
    <title>Product Details</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <style>
        body {
            margin: 0;
            padding: 40px;
            background-color: #f7f7f5;
            text-align: center;
        }

        .esraa {
            color: #2c3e50;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            margin: 24px auto 24px auto;
            padding: 20px;
            background-color: #ffffff;
            border: 1px solid #e5e5e5;
            width: 500px;
        }

        img {
            height: 280px;
            width: 500px;
            display: block;
            margin: 0 auto;
            border: 1px solid #e5e5e5;
        }

        p {
            color: #2c3e50;
            font-size: 16px;
            text-align: center;
            margin: 12px auto;
            padding: 8px;
            width: 500px;
        }

        .price {
            color: #2c3e50;
            font-size: 20px;
            font-weight: bold;
            background-color: #ffffff;
            border: 1px solid #e5e5e5;
            padding: 12px;
            margin: 20px auto;
            width: 200px;
            text-align: center;
        }

        a {
            color: #2c3e50;
            font-size: 14px;
            display: block;
            margin: 24px auto;
            text-align: center;
        }

        a:hover {
            color: #ffffff;
            background-color: #2c3e50;
        }
    </style>
</head>
<body>
<img src="{{ product.image }}"/>
<h1 class="esraa">{{ product.name }}</h1>
<p>{{ product.description }}</p>
<p class="price">${{ product.price }}</p>
<a href="{{ url_for('index') }}">Back to products</a>
</body>
</html>
